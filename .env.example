# ==============================================================================
# BOWER JJ — Environment Configuration Template
# Copy this file to .env for local development with your Supabase credentials.
# NEVER commit real production keys to version control.
# ==============================================================================

# Client (Vite Frontend) — Safe for browser exposure
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
VITE_WS_URL=localhost:3001

# Server (Authoritative Game Backend) — PRIVATE / SERVER-ONLY
PORT=3001
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-for-offline-token-validation
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
MATCHMAKING_RANKED_TIMEOUT_SEC=30
